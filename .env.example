# Groq Cloud API Settings (https://groq.com/ - Ultra-fast LPU inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL + pgvector Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carebridge

# Hugging Face Embedding Model (runs locally on CPU via sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# App Settings
APP_NAME=CareBridge AI
HOSPITAL_NAME=Metro General Hospital
DEBUG=True
